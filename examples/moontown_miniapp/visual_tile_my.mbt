///|
fn tile_my_wxss() -> String {
  ".moontown-my-layout { grid-template-columns: minmax(0, 1fr); align-items: start; }\n" +
  ".moontown-my-overview { min-width: 0; }\n" +
  ".moontown-my-inventory { background: transparent; }\n" +
  ".moontown-my-overview > .moontown-profile-card { margin-top: 0; border-color: rgba(120,53,15,0.28); background: linear-gradient(135deg,#b45309,#92400e); }\n" +
  ".moontown-my-overview > .moontown-profile-card .mt-title, .moontown-my-overview > .moontown-profile-card .mt-title text { color: #fffbeb !important; }\n" +
  ".moontown-my-overview > .moontown-profile-card .mt-meta, .moontown-my-overview > .moontown-profile-card .mt-meta text { color: #fde68a !important; }\n" +
  ".moontown-my-overview > .moontown-profile-card .moontown-profile-metric { background: rgba(255,255,255,0.12); color: #fffbeb; }\n" +
  ".moontown-my-attention { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(120,53,15,0.12); }\n" +
  ".moontown-my-attention > .bunnia-list-windowed { display: flex; flex-direction: column; gap: 8rpx; margin-top: 8rpx; }\n" +
  ".moontown-my-attention .moontown-workbench-alert { margin-top: 0; }\n" +
  ".moontown-my-inventory > .bunnia-list-windowed { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8rpx; }\n" +
  ".moontown-my-public, .moontown-my-lifecycle, .moontown-my-reviewer, .moontown-create-drawer { margin-top: 6rpx; }\n"
}
