///|
fn tile_responsive_wxss() -> String {
  "@media (max-width: 520px) { .moontown-topbar { right: 16rpx; } .moontown-passport-entry, .moontown-entry-button { min-width: 136rpx; max-width: 184rpx; } .moontown-page-grid, .moontown-page-grid.single, .moontown-page-grid.three, .moontown-my-layout, .moontown-messages-layout { grid-template-columns: 1fr; } .moontown-district-grid .bunnia-list-windowed { grid-template-columns: repeat(2,minmax(0,1fr)); } .moontown-discovery-results .bunnia-list-windowed { grid-template-columns: 1fr; } .moontown-discovery-search { grid-template-columns: minmax(0, 1fr) 128rpx; } .moontown-my-overview { order: 1; } .moontown-my-inventory { order: 2; } .moontown-my-public { order: 3; } .moontown-my-lifecycle { order: 4; } .moontown-create-drawer { order: 5; } .moontown-my-reviewer { order: 6; } .moontown-right-hud { left: 0; right: 0; top: auto; bottom: 0; margin-bottom: 122rpx; width: auto; max-height: 72vh; } .moontown-building-drawer, .moontown-create-drawer { height: auto; max-height: 40vh; border-radius: 32rpx 32rpx 0 0; } .moontown-building-drawer.details-open { max-height: 72vh; } }"
}
