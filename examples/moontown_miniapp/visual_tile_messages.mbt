///|
fn tile_messages_wxss() -> String {
  ".moontown-chat-list-header { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }\n" +
  ".moontown-chat-refresh { flex: 0 0 88rpx; width: 88rpx; min-width: 88rpx; padding: 0; font-size: 30rpx; }\n" +
  ".moontown-notice-list > .bunnia-list-windowed { display: flex; flex-direction: column; gap: 10rpx; margin-top: 12rpx; }\n" +
  ".moontown-chat-row { min-width: 0; min-height: 112rpx; margin: 0; display: grid; grid-template-columns: 72rpx minmax(0, 1fr); gap: 14rpx; padding: 16rpx; border: 1rpx solid rgba(120,53,15,0.12); border-radius: 20rpx; background: rgba(255,255,255,0.8); overflow: visible; }\n" +
  ".moontown-chat-row:active { background: #fffbeb; }\n" +
  ".moontown-chat-row.unread { border-color: #f59e0b; background: rgba(255,251,235,0.9); }\n" +
  ".moontown-chat-avatar { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 999rpx; background: #fef3c7; color: #92400e; font-size: 24rpx; font-weight: 800; }\n" +
  ".moontown-chat-avatar.kind-agent-run { background: #fef3c7; color: #92400e; }\n" +
  ".moontown-chat-avatar.kind-review { background: #fee2e2; color: #991b1b; }\n" +
  ".moontown-chat-avatar.kind-interaction { background: #dcfce7; color: #166534; }\n" +
  ".moontown-chat-avatar.kind-follow { background: #fce7f3; color: #9d174d; }\n" +
  ".moontown-chat-copy { min-width: 0; }\n" +
  ".moontown-chat-title-row { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; min-width: 0; }\n" +
  ".moontown-chat-title-row .mt-title { min-width: 0; flex: 1 1 auto; }\n" +
  ".moontown-chat-unread-dot { flex: 0 0 12rpx; width: 12rpx; height: 12rpx; border-radius: 6rpx; background: #e11d48; }\n" +
  ".moontown-chat-preview, .moontown-chat-preview text { min-width: 0; margin-top: 2rpx; color: #78716c; font-size: 22rpx; line-height: 32rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n" +
  ".moontown-message-review, .moontown-message-work { margin-top: 6rpx; }\n"
}
