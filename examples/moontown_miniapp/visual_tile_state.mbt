///|
fn tile_state_wxss() -> String {
  ".bunnia-status-review, .bunnia-status-pending, .bunnia-status-stale, .bunnia-status-waiting { border-color: #d97706; background: rgba(255,251,235,0.9); }\n" +
  ".bunnia-status-stable, .bunnia-status-ready, .bunnia-status-published { border-color: #16a34a; background: rgba(240,253,244,0.86); }\n" +
  ".bunnia-status-current, .bunnia-status-running { border-color: #b45309; background: rgba(255,247,237,0.9); }\n" +
  ".bunnia-status-blocked, .bunnia-status-failed { border-color: #dc2626; background: rgba(254,242,242,0.9); }\n" +
  ".bunnia-status-draft, .bunnia-status-shared { border-color: #78716c; background: rgba(250,250,249,0.9); }\n"
}
