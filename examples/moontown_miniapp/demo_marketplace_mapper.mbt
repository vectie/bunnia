  "    if(endpointId==='load-marketplace-notifications'){const items=safe(source.notifications,item=>this.__moontownSafeNotification(item));return {'notifications.remote':true,'notifications.items':items,'notifications.unreadCount':Math.max(0,Number(source.unread_count||0))}}\n" +
